{
  "name": "share-buttons",
  "version": "2.0.0",
  "description": "Simple social buttons for your site.",
  "scripts": {
    "test": "vitest run -c vite.lib.config.mts",
    "pretest": "npm run build:lib",
    "build:lib": "vite build -c vite.lib.config.mts",
    "build:demo": "vite build -c vite.demo.config.mts",
    "build": "npm run build:lib && npm run build:demo",
    "dev": "vite -c vite.demo.config.mts",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yauhenipakala/share-buttons.git"
  },
  "author": "Yauheni Pakala <evgeniy.pakalo@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yauhenipakala/share-buttons/issues"
  },
  "homepage": "https://ypakala.com/demo/share-buttons/",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "main": "dist/share-buttons.js",
  "module": "dist/share-buttons.mjs",
  "types": "dist/share-buttons.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/share-buttons.d.mts",
        "default": "./dist/share-buttons.mjs"
      },
      "require": {
        "types": "./dist/share-buttons.d.ts",
        "default": "./dist/share-buttons.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "social",
    "buttons",
    "share",
    "fontawesome",
    "facebook",
    "vk",
    "twitter",
    "x",
    "bluesky",
    "threads",
    "telegram",
    "linkedin",
    "pinterest",
    "reddit",
    "whatsapp",
    "odnoklassniki",
    "tumblr",
    "hackernews",
    "xing",
    "teams",
    "email",
    "print",
    "copy",
    "webshare"
  ]
}
